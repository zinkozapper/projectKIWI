# Leave blank for http://localhost:8000 (or the configured KIWI_PORT).
# For LAN access, set the HTTPS origin without a trailing slash and use a reverse proxy.
PUBLIC_URL=
# The gateway is bound to localhost only; an optional proxy can forward to this port.
KIWI_PORT=8000

# Generate unique secrets. POSTGRES_PASSWORD must use URL-safe characters only.
# JWT_SECRET must be at least 32 characters; generate HS256 JWTs signed with it,
# with role "anon" and "service_role" respectively, for these two keys.
POSTGRES_PASSWORD=
JWT_SECRET=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Opt in only after validating passkeys against the HTTPS origin and Auth version.
GOTRUE_PASSKEY_ENABLED=false
GOTRUE_WEBAUTHN_RP_ID=
GOTRUE_WEBAUTHN_RP_DISPLAY_NAME=Kiwi
GOTRUE_WEBAUTHN_RP_ORIGINS=

# For AI search to get new foods into the database
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_KEY=
FDC_API_KEY=
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
