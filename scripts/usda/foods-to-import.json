      "serving": "1 unit",
      "must": [
        "lime",
        "raw"
      ],
      "exclude": [
        "juice",
        "peel"
      ]
    },
    {
      "name": "Frozen Mixed Berries",
      "group": "fruit",
      "query": "frozen mixed berries",
      "serving": "100 g",
      "dataTypes": [
        "Branded"
      ],
      "must": [
        "mixed berr",
        "frozen"
      ],
      "exclude": [
        "yogurt",
        "confection",
        "dessert",
        "drink",
        "wine",
