{
  "_doc": "Food-group rules + foods to pull from USDA FoodData Central. See docs/usda-record-selection-rules.md. must = every term must appear in the record description; exclude = none may appear (case-insensitive). raw* = same for the raw/dry reference record. Optional servingGrams overrides the gram weight when the record has no usable portion.",
  "groups": {
    "meat": {
      "mode": "prepared",
      "serving": "4 oz",
      "note": "Cooked (no added fat) and raw records from the SAME dataset so the calorie ratio reflects real cooking yield; scale to 4 oz raw",
      "dataTypes": [
        "SR Legacy",
        "Foundation"
      ],
      "sameDataset": true
    },
    "seafood": {
      "mode": "prepared",
      "serving": "4 oz",
      "note": "Cooked (no added fat) and raw records from the SAME dataset so the calorie ratio reflects real cooking yield; scale to 4 oz raw",
      "dataTypes": [
        "SR Legacy",
        "Foundation"
      ],
      "sameDataset": true
    },
    "grain": {
      "mode": "prepared",
      "serving": "1/4 cup",
      "note": "Pull cooked, no added fat; scale to 1/4 cup dry via dry/cooked calorie ratio"
    },
    "legume": {
      "mode": "prepared",
      "serving": "1/4 cup",
      "note": "Pull cooked from dried, no added fat; scale to 1/4 cup dry"
    },
    "bread": {
      "mode": "as_sold",
      "note": "Ready to eat; serving = 1 unit (slice, tortilla)"
    },
    "fruit": {
      "mode": "raw",
      "note": "Raw; per unit (1 medium) when bought individually, grams when bought by weight/container (berries)"
    },
    "vegetable": {
      "mode": "raw",
      "serving": "100 g",
      "note": "Raw; 100 g by default, per unit (1 medium, 1 clove) when bought individually"
    },
    "dairy": {
      "mode": "as_sold",
      "note": "Serving per item (1 cup milk, 1 oz cheese)"
    },
    "nut_seed": {
      "mode": "as_sold",
      "serving": "1 oz"
    },
    "condiment": {
      "mode": "as_sold",
      "serving": "1 tbsp"
    }
  },
  "foods": [
    {
      "name": "Shrimp",
      "group": "seafood",
      "query": "shrimp cooked",
      "rawQuery": "shrimp raw",
      "must": [
        "shrimp",
        "cooked"
      ],
      "rawMust": [
        "shrimp",
        "raw"
      ],
      "rawExclude": [
        "additives",
        "cracker",
        "farm raised"
      ],
      "exclude": [
        "breaded",
        "fried",
        "imitation",
        "canned"
      ]
    },
    {
      "name": "Chickpeas / Garbanzo Beans",
      "group": "legume",
      "query": "chickpeas from dried no added fat",
      "rawQuery": "chickpeas mature seeds raw",
      "must": [
        "chickpeas",
        "from dried"
      ],
      "rawMust": [
        "chickpeas",
        "raw"
      ]
    },
    {
      "name": "Lentils",
      "group": "legume",
      "query": "lentils from dried no added fat",
      "rawQuery": "lentils raw",
      "must": [
        "lentils",
        "from dried"
      ],
      "rawMust": [
        "lentils, raw"
      ]
    },
    {
      "name": "Brown Rice",
      "group": "grain",
      "query": "rice brown cooked no added fat",
      "rawQuery": "rice brown long-grain raw",
      "must": [
        "rice, brown",
        "cooked"
      ],
      "exclude": [
        "wild",
        "peas",
        "carrots",
        "corn"
      ],
      "rawMust": [
        "rice, brown",
        "raw"
      ]
    },
    {
      "name": "Couscous",
      "group": "grain",
      "query": "couscous cooked",
      "rawQuery": "couscous dry",
      "must": [
        "couscous",
        "cooked"
      ],
      "rawMust": [
        "couscous, dry"
      ]
    },
    {
      "name": "Whole Wheat Tortillas",
      "group": "bread",
      "query": "tortilla whole wheat",
      "serving": "1 unit",
      "must": [
        "tortilla",
        "whole wheat"
      ]
    },
    {
      "name": "Sourdough Bread",
      "group": "bread",
      "query": "bread sourdough",
      "serving": "2 oz",
      "must": [
        "sourdough"
      ],
      "exclude": [
        "toasted",
        "muffin"
      ]
    },
    {
      "name": "Apples",
      "group": "fruit",
      "query": "apple raw with skin",
      "serving": "1 unit",
      "must": [
        "apple",
        "raw"
      ],
      "exclude": [
        "without skin",
        "cooked",
        "juice",
        "cider",
        "apricot"
      ]
    },
    {
      "name": "Lemon",
      "group": "fruit",
      "query": "lemon raw",
      "serving": "1 unit",
      "must": [
        "lemon",
        "raw"
      ],
      "exclude": [
        "juice",
        "peel",
        "grass"
      ]
    },
    {
      "name": "Lime",
      "group": "fruit",
