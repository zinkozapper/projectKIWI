VITE_SUPABASE_URL=https://<URL-example>
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_numbersnstuff

# Server-only values for the AI food finder (never prefix these with VITE_). On Elastic Beanstalk set them
# under Configuration → Updates, monitoring, and logging → Environment properties.
# USDA FoodData Central (free key: https://api.data.gov/signup) — also used by scripts/usda
FDC_API_KEY=
# Claude API key (https://console.anthropic.com). Optional: ANTHROPIC_MODEL (default claude-haiku-5-5)
ANTHROPIC_API_KEY=
# Supabase → Project Settings → API keys → secret / service_role key (writes new foods past RLS)
SUPABASE_SERVICE_ROLE_KEY=
